#!/usr/bin/env python3
"""Fill missing NON-bar settings into ~/.config/omarchy/shell.json from
~/.config/omarchy/shell.d/*.json. The live shell.json is the source of truth:

  - the bar is never touched (no layout, order, insert, replace or removal;
    any "bar"/"barInsert"/"barReplace"/"barSettings"/"barOrder" keys in a
    fragment are ignored with a note)
  - plugins              entries appended when their id is missing
  - disabledPlugins,
    cloneSourceRestores  values added when missing
  - other top-level keys set only when the live file does not have them
  - retired clones (~/.local/state/omarchy-config/retired-plugins, "<clone>
    <stock>" lines) are dropped from plugins/cloneSourceRestores and the stock
    plugin is removed from disabledPlugins; a bar entry of the clone is left
    alone and reported (swap it yourself)

It is not part of any install.sh. Writes only when something changes (backup
first, waits until unlocked), never when shell.json is missing.

Usage: omarchy-shell-json-build [--dry-run] [--no-reload]
"""

import copy
import json
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
FRAG_DIR = HOME / ".config/omarchy/shell.d"
TARGET = HOME / ".config/omarchy/shell.json"
RETIRED = HOME / ".local/state/omarchy-config/retired-plugins"
BACKUPS = HOME / ".local/state/omarchy-config/shell-json-backups"
KEEP_BACKUPS = 20
BAR_KEYS = {"bar", "barInsert", "barReplace", "barSettings", "barOrder"}
LIST_KEYS = ("disabledPlugins", "cloneSourceRestores")
KNOWN_ARGS = {"--dry-run", "--no-reload"}


def fill(cfg, frag, ignored):
    for key, value in frag.items():
        if key in BAR_KEYS:
            ignored.add(key)
        elif key == "plugins":
            have = {p.get("id") for p in cfg.get("plugins", []) if isinstance(p, dict)}
            for entry in value or []:
                if entry.get("id") not in have:
                    cfg.setdefault("plugins", []).append(copy.deepcopy(entry))
                    have.add(entry.get("id"))
        elif key in LIST_KEYS:
            cur = cfg.setdefault(key, [])
            cur.extend(v for v in value or [] if v not in cur)
        elif key not in cfg:
            cfg[key] = copy.deepcopy(value)


def apply_retired(cfg):
    notes = []
    if not RETIRED.is_file():
        return notes
    for line in RETIRED.read_text().splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        clone, stock = parts
        cfg["plugins"] = [p for p in cfg.get("plugins", []) if p.get("id") != clone]
        for key, drop in (("cloneSourceRestores", clone), ("disabledPlugins", stock)):
            if key in cfg:
                cfg[key] = [v for v in cfg[key] if v != drop]
                if not cfg[key]:
                    cfg.pop(key)
        for entries in (cfg.get("bar", {}).get("layout", {}) or {}).values():
            if any(isinstance(e, dict) and e.get("id") == clone for e in entries or []):
                notes.append(f"bar still shows retired {clone}: swap it for {stock} yourself")
    return notes


def backup(text):
    BACKUPS.mkdir(parents=True, exist_ok=True)
    (BACKUPS / f"shell-{time.strftime('%Y-%m-%d-%H%M%S')}.json").write_text(text)
    for old in sorted(BACKUPS.glob("shell-*.json"))[:-KEEP_BACKUPS]:
        old.unlink()


def wait_unlocked():
    gate = HOME / ".local/bin/omarchy-safe-gate"
    if not gate.is_file():
        return True
    return subprocess.run([str(gate), "--lock-only", "--max", "600"]).returncode == 0


def main(argv):
    if set(argv) - KNOWN_ARGS:
        bad = sorted(set(argv) - KNOWN_ARGS - {"-h", "--help", "help"})
        if bad:
            print("unknown argument(s): " + " ".join(bad) + " (nothing was changed)", file=sys.stderr)
        print(__doc__)
        return 2 if bad else 0
    if not TARGET.is_file():
        print(f"{TARGET} is missing: nothing to fill (the shell creates it).", file=sys.stderr)
        return 1
    live_text = TARGET.read_text()
    cfg = json.loads(live_text)
    bar_before = json.dumps(cfg.get("bar"), sort_keys=True)
    ignored = set()
    for path in sorted(FRAG_DIR.glob("*.json")):
        fill(cfg, json.loads(path.read_text()), ignored)
    notes = apply_retired(cfg)
    assert json.dumps(cfg.get("bar"), sort_keys=True) == bar_before, "bar changed: refusing"
    for n in notes:
        print(n, file=sys.stderr)
    if ignored:
        print("ignored bar keys in shell.d (the live bar is yours): " + ", ".join(sorted(ignored)), file=sys.stderr)
    text = json.dumps(cfg, indent=2, ensure_ascii=False) + "\n"
    if "--dry-run" in argv:
        sys.stdout.write(text)
        return 0
    if json.loads(live_text) == cfg:
        print(f"{TARGET} already has everything")
        return 0
    if not wait_unlocked():
        print(f"screen is locked: {TARGET} left alone", file=sys.stderr)
        return 75
    backup(live_text)
    tmp = TARGET.with_suffix(".json.tmp")
    tmp.write_text(text)
    os.chmod(tmp, 0o600)
    tmp.replace(TARGET)
    print(f"Filled missing settings into {TARGET}")
    if "--no-reload" not in argv:
        subprocess.run(["omarchy-shell", "shell", "reloadConfig"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
