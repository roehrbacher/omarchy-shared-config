#!/usr/bin/env python3
"""Put a bar widget into the live bar ONCE, right after a neighbour.

  omarchy-bar-add-once <widget-id> <after-id> [<after-id> ...]

Inserts {"id": <widget-id>} right after the first <after-id> found in
bar.layout (else at the end of the right section). Only the first time:
the id is then recorded in ~/.local/state/omarchy-config/bar-added, so if
you remove the widget from the bar later it is never put back. Nothing else
in the bar is moved. install.sh backs shell.json up first (uninstall.sh
restores it). Does nothing when shell.json is missing.
"""
import json, os, sys
from pathlib import Path

HOME = Path.home()
TARGET = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy/shell.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy-config/bar-added"


def main(argv):
    if len(argv) < 2:
        print(__doc__); return 2
    wid, after = argv[0], argv[1:]
    done = STATE.read_text().split() if STATE.is_file() else []
    if wid in done or not TARGET.is_file():
        return 0
    cfg = json.loads(TARGET.read_text())
    layout = cfg.setdefault("bar", {}).setdefault("layout", {})
    ids = lambda sec: [e.get("id") if isinstance(e, dict) else e for e in layout.get(sec) or []]
    if not any(wid in ids(s) for s in layout):
        spot = None
        for a in after:
            for sec in layout:
                if a in ids(sec):
                    spot = (sec, ids(sec).index(a) + 1); break
            if spot: break
        sec, i = spot or ("right", len(layout.get("right") or []))
        layout.setdefault(sec, []).insert(i, {"id": wid})
        tmp = TARGET.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")
        os.chmod(tmp, 0o600)
        tmp.replace(TARGET)
        print(f"Added {wid} to the bar ({sec})")
    STATE.parent.mkdir(parents=True, exist_ok=True)
    with STATE.open("a") as f:
        f.write(wid + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
