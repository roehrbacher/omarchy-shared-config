#!/bin/bash
# Managed by omarchy-shared-config.
# Apply the timezone from the last nudge notification.

set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/settings/timezone-nudge.json"

if [[ ! -f $STATE_FILE ]]; then
  echo "No pending timezone nudge" >&2
  exit 1
fi

eval "$(python3 - "$STATE_FILE" <<'PY'
import json, shlex, sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text())
tz = data.get("timezone") or ""
city = data.get("city") or tz
lat = data.get("latitude")
lon = data.get("longitude")
print(f"timezone={shlex.quote(tz)}")
print(f"city={shlex.quote(str(city))}")
print(f"lat={shlex.quote('' if lat is None else str(lat))}")
print(f"lon={shlex.quote('' if lon is None else str(lon))}")
PY
)"

if [[ -z $timezone ]] || ! timedatectl list-timezones | grep -Fxq "$timezone"; then
  echo "Invalid pending timezone: ${timezone:-empty}" >&2
  exit 1
fi

current=$(timedatectl show -p Timezone --value)
if [[ $timezone != "$current" ]]; then
  sudo -n /usr/bin/timedatectl set-timezone "$timezone"
fi

if [[ $lat =~ ^-?[0-9]+(\.[0-9]+)?$ && $lon =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
  omarchy weather location --set "$city" "$lat,$lon" >/dev/null
else
  omarchy weather location --set "$city" >/dev/null
fi

omarchy-nightlight-sun-schedule >/dev/null 2>&1 || true
omarchy-shell -q omarchy.clock refresh >/dev/null 2>&1 || true
rm -f "$STATE_FILE"

omarchy notification send -g 󰥔 -u normal "Timezone is now set to $timezone"
echo "Timezone set to $timezone ($city)"
