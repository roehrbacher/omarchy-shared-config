#!/usr/bin/env python3
"""Build ~/.config/omarchy/extensions/omarchy-menu.jsonc.

Omarchy's menu reads exactly one user file, so this assembles it from:
  1. a "Folders" row for every folder Timon made: all non-hidden folders in ~,
     plus one level inside the usual folders (Documents, Pictures, Work, ...)
     and a second level inside Documents/Pictures/Videos/Music/Desktop.
     Top-level folders show in the Folders submenu; deeper ones are found by
     typing their name in the menu (Super+Space), shown as "Folders › Pictures".
  2. ~/.config/omarchy/menu.d/*.jsonc fragments, in name order, merged per id
     (later wins field by field, like Omarchy's own merge). 00-shared.jsonc
     comes from omarchy-shared-config; machine repos may add e.g. 50-pc.jsonc.
     A fragment row that reuses a stock id only needs the fields it changes:
     the rest is copied from Omarchy's default menu, because the menu would
     otherwise blank them.

Skipped: hidden folders, git repo internals, node_modules/caches/build dirs,
game and tool folders, and the subfolders of anything with more than
MAX_CHILDREN subfolders (synced photo albums and the like). Add your own
skips, one folder name or ~-relative path per line, to
~/.config/omarchy/menu.d/folders-ignore.

Runs from omarchy-menu-build.path (folder changes) and .timer (fallback).
Only rewrites the file when its content changes. Usage:
  omarchy-menu-build [--dry-run] [--quiet]
"""

import json
import os
import re
import shlex
import sys
from pathlib import Path

HOME = Path.home()
FRAG_DIR = HOME / ".config/omarchy/menu.d"
IGNORE_FILE = FRAG_DIR / "folders-ignore"
TARGET = HOME / ".config/omarchy/extensions/omarchy-menu.jsonc"
STOCK = Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "default/omarchy/omarchy-menu.jsonc"
MARKER = "// Generated by omarchy-menu-build"

# Standard folders: fixed icon, order and extra search words.
STANDARD = [
    ("Desktop", "\uf108", []),
    ("Documents", "\uf15c", ["docs"]),
    ("Downloads", "\uf019", ["dl"]),
    ("Music", "\uf001", []),
    ("Pictures", "\uf03e", ["pics", "photos", "images"]),
    ("Videos", "\uf03d", ["movies"]),
    ("Projects", "\uf07b", []),
    ("Work", "\uf0b1", []),
    ("Wallpapers", "\uf03e", []),
    ("src", "\uf121", ["source"]),
]
FOLDER_ICON = "\uf07b"
# Folders whose subfolders are listed (level 1), and those listed one deeper.
LEVEL1 = {"Desktop", "Documents", "Downloads", "Music", "Pictures", "Videos",
          "Projects", "projects", "Work", "src", "Wallpapers"}
LEVEL2 = {"Desktop", "Documents", "Music", "Pictures", "Videos"}
MAX_CHILDREN = 50
MAX_ROWS = 400
SKIP_NAMES = {
    "node_modules", "__pycache__", "venv", "env", "target", "build", "dist",
    "cache", "Cache", "caches", "tmp", "temp", "lost+found", "snap", "go",
    "Steam", "SteamLibrary", "steamapps", "Games", "games",
    # made by tools/agents, not by hand
    "terminals", "agent-tools",
}


def load_ignores():
    try:
        lines = IGNORE_FILE.read_text().splitlines()
    except OSError:
        return set()
    return {l.strip().strip("/") for l in lines if l.strip() and not l.strip().startswith("#")}


def subdirs(path):
    try:
        with os.scandir(path) as it:
            out = [e for e in it if not e.name.startswith(".") and e.is_dir(follow_symlinks=False)]
    except OSError:
        return []
    return sorted(out, key=lambda e: e.name.lower())


def slug(value):
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-") or "folder"


def open_action(path):
    rel = os.path.relpath(path, HOME)
    target = '"$HOME"' if rel == "." else '"$HOME"/' + shlex.quote(rel)
    return "uwsm-app -- nautilus --new-window " + target


def folder_rows():
    ignores = load_ignores()
    rows = {}
    taken = set()

    def add(parent, name, path, icon=FOLDER_ICON, aliases=None):
        base = parent + "." + slug(name)
        row_id = base
        n = 2
        while row_id in taken:
            row_id = f"{base}-{n}"
            n += 1
        taken.add(row_id)
        row = {"icon": icon, "label": name, "action": open_action(path)}
        if aliases:
            row["aliases"] = aliases
        rows[row_id] = row
        return row_id

    def skipped(entry):
        rel = os.path.relpath(entry.path, HOME)
        return entry.name in SKIP_NAMES or entry.name in ignores or rel in ignores

    def is_repo(path):
        return os.path.exists(os.path.join(path, ".git"))

    add("folders", "Home", str(HOME), "\uf015", ["home-folder"])
    top = {e.name: e for e in subdirs(HOME) if not skipped(e)}
    ordered = [n for n, _, _ in STANDARD if n in top]
    ordered += [n for n in top if n not in ordered]
    meta = {n: (i, a) for n, i, a in STANDARD}

    for name in ordered:
        icon, aliases = meta.get(name, (FOLDER_ICON, []))
        top_id = add("folders", name, top[name].path, icon, aliases)
        if name not in LEVEL1 or is_repo(top[name].path):
            continue
        for child in subdirs(top[name].path):
            if skipped(child) or len(rows) >= MAX_ROWS:
                continue
            child_id = add(top_id, child.name, child.path)
            if name not in LEVEL2 or is_repo(child.path):
                continue
            grand = [g for g in subdirs(child.path) if not skipped(g)]
            if len(grand) > MAX_CHILDREN:
                continue
            for g in grand:
                if len(rows) >= MAX_ROWS:
                    break
                add(child_id, g.name, g.path)
    return rows


def strip_jsonc(raw):
    raw = re.sub(r"^\s*//[^\n]*(\n|$)", "", raw, flags=re.M)
    return re.sub(r",(\s*[}\]])", r"\1", raw)


def fragments():
    merged = {}
    for path in sorted(FRAG_DIR.glob("*.jsonc")):
        try:
            data = json.loads(strip_jsonc(path.read_text()))
        except (OSError, ValueError) as err:
            print(f"Skipping {path}: {err}", file=sys.stderr)
            continue
        for row_id, row in data.items():
            if isinstance(row, dict):
                merged.setdefault(row_id, {}).update(row)
    return merged


def stock_rows():
    try:
        data = json.loads(strip_jsonc(STOCK.read_text()))
    except (OSError, ValueError):
        return {}
    return data.get("items", data) if isinstance(data, dict) else {}


def main(argv):
    rows = folder_rows()
    # The menu resets every field a user row leaves out (label falls back to
    # the id, provider/action to empty), so a row that tweaks a stock entry
    # starts from the stock fields and only changes what the fragment sets.
    stock = stock_rows()
    for row_id, row in fragments().items():
        if row_id not in rows and isinstance(stock.get(row_id), dict):
            rows[row_id] = dict(stock[row_id])
        rows.setdefault(row_id, {}).update(row)
    lines = [
        "{",
        f"  {MARKER} from ~/.config/omarchy/menu.d/*.jsonc",
        "  // and your folders. Do not edit here: changes are overwritten.",
        "  // Put your own rows in ~/.config/omarchy/menu.d/90-local.jsonc instead.",
    ]
    body = [f"  {json.dumps(k)}: {json.dumps(v, ensure_ascii=False, separators=(',', ':'))}"
            for k, v in rows.items()]
    text = "\n".join(lines) + "\n" + ",\n".join(body) + "\n}\n"
    json.loads(strip_jsonc(text))  # never write something the menu can't parse
    if "--dry-run" in argv:
        sys.stdout.write(text)
        return 0
    old = TARGET.read_text() if TARGET.is_file() else ""
    if old == text:
        return 0
    if old and MARKER not in old:
        keep = TARGET.with_name(TARGET.name + ".pre-menu-build")
        if not keep.exists():
            keep.write_text(old)
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    # Written in place, not via rename: the shell's file watcher reliably
    # hot-reloads in-place writes (that is how hand edits arrive).
    with open(TARGET, "w") as f:
        f.write(text)
    if "--quiet" not in argv:
        print(f"Wrote {TARGET} ({len(rows)} rows)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
