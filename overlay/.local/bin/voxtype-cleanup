#!/bin/bash
# Voxtype post-process: clean dictation via local llama.cpp (OpenAI API).
# Prints raw text unchanged if the server is off or anything fails.
set -o pipefail
TEXT="$(cat)"
URL="${VOXTYPE_LLM_URL:-http://127.0.0.1:8080/v1/chat/completions}"
SYS='You clean up dictated text. Keep the original language (English or German, never translate). Fix punctuation, capitalization and grammar, remove filler words (um, uh, äh, ähm, also, halt) and false starts. Keep the meaning, wording and tone; do not add, answer or explain anything. Output only the cleaned text.'
OUT="$(jq -n --arg s "$SYS" --arg t "$TEXT" '{model:"local",temperature:0.1,max_tokens:512,
  chat_template_kwargs:{enable_thinking:false},
  messages:[{role:"system",content:$s},{role:"user",content:$t}]}' |
  curl -sf -m 8 --connect-timeout 0.3 -H 'Content-Type: application/json' -d @- "$URL" |
  jq -er '.choices[0].message.content' | sed '/<think>/,/<\/think>/d')" 
if [ -n "${OUT//[[:space:]]/}" ]; then printf '%s\n' "$OUT"; else printf '%s\n' "$TEXT"; fi
