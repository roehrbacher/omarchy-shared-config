#!/usr/bin/env bash
# Build ~/.config/brave-flags.conf from ~/.config/brave-flags.d/*.conf.
#   00-shared.conf   omarchy-shared-config
#   50-<machine>.conf machine repo
#   90-local.conf    yours, untracked
# @HOME@ -> $HOME. All --load-extension= values are merged into one line and
# all --enable-features= values into another (Chromium honours only the last
# of each). Writes only when the result changes. Brave reads the file on start.
set -euo pipefail
dir="$HOME/.config/brave-flags.d"
out="$HOME/.config/brave-flags.conf"
shopt -s nullglob
files=("$dir"/*.conf)
(( ${#files[@]} )) || { echo "No $dir/*.conf, leaving $out alone"; exit 0; }

new=$(cat "${files[@]}" | sed "s|@HOME@|$HOME|g" | awk '
  function add(list, v,   n, i, parts) {
    n = split(v, parts, ",")
    for (i = 1; i <= n; i++) if (parts[i] != "" && !((list, parts[i]) in seen)) {
      seen[list, parts[i]] = 1; vals[list] = vals[list] (vals[list] == "" ? "" : ",") parts[i]
    }
  }
  /^[[:space:]]*(#|$)/ { next }
  { sub(/[[:space:]]+$/, "") }
  /^--load-extension=/ { if (!("ext" in pos)) { pos["ext"] = ++n; line[n] = "@EXT@" } add("ext", substr($0, 18)); next }
  /^--enable-features=/ { if (!("feat" in pos)) { pos["feat"] = ++n; line[n] = "@FEAT@" } add("feat", substr($0, 19)); next }
  !($0 in dup) { dup[$0] = 1; line[++n] = $0 }
  END {
    print "# Generated by omarchy-brave-flags-build from ~/.config/brave-flags.d/ - edit those, not this file."
    for (i = 1; i <= n; i++) {
      if (line[i] == "@EXT@") print "--load-extension=" vals["ext"]
      else if (line[i] == "@FEAT@") print "--enable-features=" vals["feat"]
      else print line[i]
    }
  }')

if [[ -f $out ]] && [[ $(cat "$out") == "$new" ]]; then
  exit 0
fi
printf '%s\n' "$new" >"$out.tmp" && mv "$out.tmp" "$out"
echo "Wrote $out (restart Brave to apply)"
