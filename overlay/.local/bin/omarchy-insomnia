#!/bin/bash
# Insomnia (github.com/roehrbacher/omarchy-insomnia): keep this machine awake
# and reachable (SSH, downloads, agents) for a while. Started from the Insomnia eye in the
# bar centre (an indicator in timon.indicators). Named after, and using the eye of,
# Krish Garg's macOS app Insomnia (github.com/krishhgg/Insomnia, MIT).
#
# A session is the transient user unit omarchy-insomnia.service: it holds a
# systemd-inhibit block lock for its lifetime and checks every 15 s whether
# time is up (or, if configured, the battery is at the floor). State lives in
# $XDG_RUNTIME_DIR, so a reboot or logout never leaves a session behind.
# Independent of Omarchy's coffee (stay awake) toggle.
#
# What a session does depends on the machine (omarchy-machine-kind: battery +
# lid = laptop, else desktop):
#   desktop: inhibit sleep, so nothing suspends or hibernates; you keep
#     working: no lock and no screen-off on start, unlocking doesn't end it.
#     Omarchy's screensaver, lock and display-off timers stay as they are
#     (they never suspend; the coffee toggle is still the "never lock" switch).
#   laptop: inhibit sleep + handle-lid-switch, so nothing suspends and
#     closing the lid on battery keeps
#     it running like on AC (omarchy-lid: lock + screen off + quiet mode); no
#     lock on start; survives unlocks (lid close/open cycles). It does NOT end
#     at a battery level: it can't be started on battery at/below the
#     low-battery hibernate level (HIBERNATE_PERCENT in
#     ~/.config/omarchy/low-battery-hibernate.conf, default 8 %; "battery too
#     low"; on AC any level is fine), and the low-battery
#     hibernate (github.com/roehrbacher/omarchy-low-battery-hibernate) is the
#     safety net: near empty it ends the session and hibernates, also with the
#     lid closed. When the time is up with the lid closed on battery, it suspends.
# Optional overrides (nothing shipped) in ~/.config/omarchy/insomnia.conf,
# sourced bash after the mode defaults:
#   INSOMNIA_MODE=laptop|desktop         force the mode (read by omarchy-machine-kind)
#   INSOMNIA_INHIBIT=sleep:handle-lid-switch   what systemd-inhibit blocks
# Idle is never inhibited: the screen still blanks and locks on the normal idle
# timers (timon.idle). Omarchy's coffee toggle is the "never blank or lock" switch.
#   INSOMNIA_LOCK_ON_START=0             lock + screen off on start (1/0)
#   INSOMNIA_FLOOR=20                    end on battery at/below this % (default empty: never)
#   INSOMNIA_MIN_START=5                 refuse to start on battery at/below this %
#                                        (laptop default: the hibernate level, see
#                                        above; empty: always allow)
#   INSOMNIA_END_ON_UNLOCK=0             end when the lock screen is unlocked during
#                                        the session (default 0; set 1 to end the session
#                                        when you unlock, i.e. you are back)
#   INSOMNIA_DESC="..."                  one line shown in notifications
#   INSOMNIA_TOOLTIP="..."               the bar icon's short tooltip (like the coffee's "Stay Awake")
#   insomnia_on_end() { ...; }           called after the session ended, $1 = reason
#                                        (timer | stopped | unlocked | floor <pct>)
#
#   omarchy-insomnia start <30m|1h|2h|4h|on|MINUTES>   start (or replace)
#   omarchy-insomnia extend <30m|1h|...>                add time
#   omarchy-insomnia stop
#   omarchy-insomnia click            bar left click: stop if on, else start
#                                     (laptop: 1 h, desktop: until turned off)
#   omarchy-insomnia set <on|off>     what the bar icon sends: the state it now
#                                     shows (on = like click; no-op if already)
#   omarchy-insomnia status [--json]
#   omarchy-insomnia menu                               picker (bar widget)
#   omarchy-insomnia check-floor <percent> <battery|ac> dry-run of the floor rule
#   omarchy-insomnia check-start <percent> <battery|ac> dry-run of the start rule
#
# Testing: INSOMNIA_FAKE_BATTERY="<percent> <battery|ac>" (or "@/file", re-read
# every check) fakes the battery, INSOMNIA_FAKE_LOCK="@/file" (containing
# true/false) fakes the lock state, and INSOMNIA_DRY_RUN=1 tells the end hook to
# only log what it would do (both passed into the unit by `start`).
# INSOMNIA_UNIT=<name>.service runs a session under another unit name (tests),
# and with INSOMNIA_DRY_RUN the caller's PATH is passed in too (stubs).
set -u

UNIT=${INSOMNIA_UNIT:-omarchy-insomnia.service}
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${UNIT%.service}"
SELF=$(readlink -f "$0")
CONF="$HOME/.config/omarchy/insomnia.conf"
# Change stamp for the bar icon: rewritten on every start/stop/extend/end, so
# the icon (a FileView watching this file) re-reads the state at once instead
# of polling. Outside RUN_DIR because that is removed when a session ends.
STATE_FILE="${RUN_DIR}.state"
changed() { date +%s%N >"$STATE_FILE" 2>/dev/null || true; }
# Changes are serialized (rapid clicks queue up in order) and `status` waits
# for a change in flight, so the icon never reads a half-done start/stop.
LOCK_FILE="${RUN_DIR}.lock"
lock() { exec 9>>"$LOCK_FILE" && flock "$@" 9; }

INSOMNIA_MODE=$(omarchy-machine-kind 2>/dev/null || echo desktop)

# The low-battery hibernate level, same rule as the battery plugin
# (BatteryModel.parseTriggerPercent): HIBERNATE_PERCENT=1..50, otherwise 8.
hibernate_percent() {
  local f=${LOW_BATTERY_HIBERNATE_CONF:-$HOME/.config/omarchy/low-battery-hibernate.conf} v
  v=$(sed -n "s/^[[:space:]]*HIBERNATE_PERCENT[[:space:]]*=[[:space:]]*[\"']\{0,1\}\([0-9]\{1,\}\)[\"']\{0,1\}[[:space:]]*\(#.*\)\{0,1\}$/\1/p" "$f" 2>/dev/null | head -1)
  if [[ $v =~ ^[0-9]+$ ]] && (( 10#$v >= 1 && 10#$v <= 50 )); then echo $((10#$v)); else echo 8; fi
}

lid_closed() {
  [[ $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager LidClosed 2>/dev/null) == "b true" ]]
}

if [[ $INSOMNIA_MODE == laptop ]]; then
  INSOMNIA_INHIBIT="sleep:handle-lid-switch"
  INSOMNIA_LOCK_ON_START=0
  INSOMNIA_FLOOR=""
  INSOMNIA_MIN_START=$(hibernate_percent)
  INSOMNIA_END_ON_UNLOCK=0
  INSOMNIA_DESC="Closing the lid keeps the laptop running, also on battery"
  INSOMNIA_TOOLTIP="Stay awake with lid closed"
  # Session over: if the lid is closed on battery, do what logind would have
  # done (continue frozen apps and restore the profile first).
  insomnia_on_end() {
    local src
    read -r _ src < <(battery_reading)
    if lid_closed && [[ $src == battery ]]; then
      omarchy-lid-quiet stop >/dev/null 2>&1
      if [[ -n ${INSOMNIA_DRY_RUN:-} ]]; then
        echo "dry-run: would suspend now (lid closed, on battery)"
      else
        systemctl suspend
      fi
    fi
  }
else
  INSOMNIA_INHIBIT="sleep"
  INSOMNIA_LOCK_ON_START=0
  INSOMNIA_FLOOR=""
  INSOMNIA_MIN_START=""
  INSOMNIA_END_ON_UNLOCK=0
  INSOMNIA_DESC="No suspend or hibernate; screensaver and lock as usual"
  INSOMNIA_TOOLTIP="Never suspend"
  insomnia_on_end() { :; }
fi
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"
[[ -n ${INSOMNIA_FLOOR_OVERRIDE:-} ]] && INSOMNIA_FLOOR=$INSOMNIA_FLOOR_OVERRIDE

notify() { omarchy-notification-send -g "󰈈" "$@" >/dev/null 2>&1 || true; }

# "<percent> <battery|ac>"
battery_reading() {
  if [[ ${INSOMNIA_FAKE_BATTERY:-} == @* ]]; then cat "${INSOMNIA_FAKE_BATTERY#@}"; return; fi
  if [[ -n ${INSOMNIA_FAKE_BATTERY:-} ]]; then echo "$INSOMNIA_FAKE_BATTERY"; return; fi
  local pct src
  pct=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower/devices/DisplayDevice org.freedesktop.UPower.Device Percentage 2>/dev/null | awk '{printf "%d", $2 + 0.5}')
  [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]] && src=battery || src=ac
  echo "${pct:-100} $src"
}

# "true" / "false" from the lock screen (timon.lock / omarchy.lock), "" if
# the shell doesn't answer (e.g. restarting): unknown, changes nothing.
lock_state() {
  if [[ ${INSOMNIA_FAKE_LOCK:-} == @* ]]; then cat "${INSOMNIA_FAKE_LOCK#@}" 2>/dev/null; return; fi
  local v
  v=$(timeout 3 omarchy-shell lock isLocked 2>/dev/null)
  [[ $v == true || $v == false ]] && echo "$v"
}

# Exit 0 when the session must end because of the battery floor.
below_floor() { [[ -n $INSOMNIA_FLOOR && $2 == battery ]] && (( $1 <= INSOMNIA_FLOOR )); }

# Exit 0 when a session must not start: on battery at/below INSOMNIA_MIN_START.
too_low_to_start() { [[ -n ${INSOMNIA_MIN_START:-} && $2 == battery ]] && (( $1 <= INSOMNIA_MIN_START )); }

active() { systemctl --user is-active --quiet "$UNIT"; }

end_epoch() { cat "$RUN_DIR/end" 2>/dev/null || echo 0; }

to_minutes() {
  case "$1" in
  on | forever | until-off | 0) echo 0 ;;
  *h) echo $(( ${1%h} * 60 )) ;;
  *m | *min) local v=${1%min}; v=${v%m}; echo "$v" ;;
  *[!0-9]* | "") return 1 ;;
  *) echo "$1" ;;
  esac
}

fmt_left() {
  local s=$1
  (( s < 0 )) && s=0
  local h=$(( s / 3600 )) m=$(( (s % 3600 + 59) / 60 ))
  (( m == 60 )) && { h=$((h + 1)); m=0; }
  if (( h > 0 )); then printf '%d:%02d' "$h" "$m"; else printf '%dm' "$m"; fi
}

human() { local m=$1; if (( m == 0 )); then echo "until turned off"; elif (( m % 60 == 0 )); then echo "$((m / 60)) h"; else echo "$m min"; fi; }

lock_and_blank() {
  [[ $INSOMNIA_LOCK_ON_START == 1 ]] || return 0
  if [[ -n ${INSOMNIA_DRY_RUN:-} ]]; then echo "dry-run: would lock + turn the screen off"; return 0; fi
  setsid -f omarchy-screen-off >/dev/null 2>&1 </dev/null
}

start() {
  local mins
  mins=$(to_minutes "${1:-1h}") || { echo "Unknown duration: $1" >&2; exit 1; }
  read -r pct src < <(battery_reading)
  if too_low_to_start "$pct" "$src"; then
    notify -u critical "Insomnia not started" "Battery too low (${pct}%). Plug in to use Insomnia."
    echo "Battery too low: ${pct}% on battery (needs more than ${INSOMNIA_MIN_START}%, or AC)" >&2
    exit 1
  fi
  if below_floor "$pct" "$src"; then
    notify "Insomnia not started" "Battery is at ${pct}%, the floor is ${INSOMNIA_FLOOR}%."
    echo "Battery ${pct}% is at/below the ${INSOMNIA_FLOOR}% floor" >&2
    exit 1
  fi
  mkdir -p "$RUN_DIR"
  if (( mins == 0 )); then echo 0 >"$RUN_DIR/end"; else echo $(( $(date +%s) + mins * 60 )) >"$RUN_DIR/end"; fi
  rm -f "$RUN_DIR/reason"
  if active; then
    changed
    notify "Insomnia" "Now $(human "$mins")."
    return 0
  fi
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
  local envs=() v
  for v in INSOMNIA_FAKE_BATTERY INSOMNIA_FAKE_LOCK INSOMNIA_DRY_RUN INSOMNIA_FLOOR_OVERRIDE INSOMNIA_UNIT LOW_BATTERY_HIBERNATE_CONF; do
    [[ -n ${!v:-} ]] && envs+=(-E "$v=${!v}")
  done
  [[ -n ${INSOMNIA_DRY_RUN:-} ]] && envs+=(-E "PATH=$PATH")
  systemd-run --user --quiet --collect --unit="$UNIT" \
    --description="Insomnia: keep this machine awake and reachable" \
    "${envs[@]}" -p ExecStopPost="$SELF _ended" \
    systemd-inhibit --what="$INSOMNIA_INHIBIT" --mode=block \
    --who="Insomnia" --why="Keep running and reachable (omarchy-insomnia)" \
    "$SELF" _hold || { rm -f "$RUN_DIR/end"; changed; exit 1; }
  changed
  notify "Insomnia on" "$INSOMNIA_DESC, $(human "$mins")."
  lock_and_blank
}

extend() {
  active || { start "${1:-1h}"; return; }
  local mins end
  mins=$(to_minutes "${1:-1h}") || exit 1
  end=$(end_epoch)
  if (( mins == 0 )); then echo 0 >"$RUN_DIR/end"
  elif (( end != 0 )); then
    (( end < $(date +%s) )) && end=$(date +%s)
    echo $(( end + mins * 60 )) >"$RUN_DIR/end"
  fi
  changed
  notify "Insomnia extended" "$(status_line)"
}

stop() {
  active || { echo "Insomnia is off"; return 0; }
  mkdir -p "$RUN_DIR"
  echo stopped >"$RUN_DIR/reason"
  systemctl --user stop "$UNIT"
  changed
}

status_line() {
  if ! active; then echo "Insomnia is off ($INSOMNIA_MODE mode)"; return; fi
  local end; end=$(end_epoch)
  if (( end == 0 )); then echo "On until turned off"; else echo "$(fmt_left $(( end - $(date +%s) ))) left"; fi
}

json_str() { local s=${1//\\/\\\\}; printf '"%s"' "${s//\"/\\\"}"; }

status() {
  if [[ ${1:-} == --json ]]; then
    [[ -e $STATE_FILE ]] || changed
    local floor=${INSOMNIA_FLOOR:-null} minstart=${INSOMNIA_MIN_START:-null}
    if active; then
      local end left=-1; end=$(end_epoch)
      (( end != 0 )) && left=$(( end - $(date +%s) ))
      (( left < -1 )) && left=0
      printf '{"active":true,"mode":"%s","end":%s,"left":%s,"text":"%s","floor":%s,"minStart":%s,"desc":%s,"tooltip":%s,"stateFile":%s}\n' "$INSOMNIA_MODE" "$end" "$left" "$( (( end == 0 )) && echo "∞" || fmt_left "$left")" "$floor" "$minstart" "$(json_str "$INSOMNIA_DESC")" "$(json_str "$INSOMNIA_TOOLTIP")" "$(json_str "$STATE_FILE")"
    else
      printf '{"active":false,"mode":"%s","floor":%s,"minStart":%s,"desc":%s,"tooltip":%s,"stateFile":%s}\n' "$INSOMNIA_MODE" "$floor" "$minstart" "$(json_str "$INSOMNIA_DESC")" "$(json_str "$INSOMNIA_TOOLTIP")" "$(json_str "$STATE_FILE")"
    fi
  else
    status_line
  fi
}

# Runs inside systemd-inhibit for the life of the session. Checks every 5 s:
# time up, battery floor (only if configured, every 15 s), and with
# INSOMNIA_END_ON_UNLOCK a locked -> unlocked change of the lock screen.
hold() {
  trap 'exit 0' TERM INT
  local end pct src tick=0 lock seen_locked=0
  while :; do
    end=$(end_epoch)
    if (( end != 0 )) && (( $(date +%s) >= end )); then
      echo timer >"$RUN_DIR/reason"; exit 0
    fi
    if [[ -n $INSOMNIA_FLOOR ]] && (( tick % 3 == 0 )); then
      read -r pct src < <(battery_reading)
      if below_floor "$pct" "$src"; then
        echo "floor $pct" >"$RUN_DIR/reason"; exit 0
      fi
    fi
    if [[ $INSOMNIA_END_ON_UNLOCK == 1 ]]; then
      lock=$(lock_state)
      if [[ $lock == true ]]; then
        seen_locked=1
      elif [[ $lock == false ]] && (( seen_locked )); then
        echo unlocked >"$RUN_DIR/reason"; exit 0
      fi
    fi
    tick=$((tick + 1))
    sleep 5 &
    wait $!
  done
}

# ExecStopPost: the inhibitor is gone by now.
ended() {
  local reason
  reason=$(cat "$RUN_DIR/reason" 2>/dev/null)
  rm -rf "$RUN_DIR"
  changed
  # No reason = the unit was torn down by logout/shutdown: do nothing more.
  [[ -n $reason ]] || return 0
  case $reason in
  timer) notify "Insomnia off" "Time is up, normal sleep behaviour is back." ;;
  floor*) notify -u critical "Insomnia off" "Battery at ${reason#floor }%, the floor is ${INSOMNIA_FLOOR}%." ;;
  stopped) notify "Insomnia off" "Normal sleep behaviour is back." ;;
  unlocked) notify "Insomnia off" "Unlocked, so the session ended. Normal sleep behaviour is back." ;;
  esac
  insomnia_on_end "$reason"
}

menu() {
  local opts=() choice
  if active; then
    opts+=("󰈉	Stop	$(status_line)" "󰐕	+30 min" "󰐕	+1 h" "󰐕	+2 h" "󰐕	Until turned off")
  else
    opts+=("󰔛	30 min" "󰔛	1 h" "󰔛	2 h" "󰔛	4 h" "󰔟	Until turned off")
  fi
  choice=$(omarchy-menu-select "Insomnia" "${opts[@]}") || exit 0
  case "${choice%%	*}" in
  Stop) stop ;;
  "+30 min") extend 30m ;;
  "+1 h") extend 1h ;;
  "+2 h") extend 2h ;;
  "30 min") start 30m ;;
  "1 h") start 1h ;;
  "2 h") start 2h ;;
  "4 h") start 4h ;;
  "Until turned off") if active; then extend on; else start on; fi ;;
  esac
}

case "${1:-}" in
start | extend | stop | click | set | toggle | menu) lock -x -w 30 || true ;;
status) lock -s -w 3 || true ;;
esac

case "${1:-}" in
set)
  trap changed EXIT   # even a refused start ends the icon's wait
  case "${2:-}" in
  on) if active; then changed; elif [[ $INSOMNIA_MODE == laptop ]]; then start 1h; else start on; fi ;;
  off) if active; then stop; else changed; fi ;;
  *) echo "usage: omarchy-insomnia set <on|off>" >&2; exit 1 ;;
  esac ;;
start) start "${2:-1h}" ;;
extend) extend "${2:-1h}" ;;
stop) stop ;;
status) status "${2:-}" ;;
menu) menu ;;
click) if active; then stop; elif [[ $INSOMNIA_MODE == laptop ]]; then start 1h; else start on; fi ;;
toggle) if active; then stop; else start "${2:-1h}"; fi ;;
check-floor)
  if below_floor "${2:?percent}" "${3:?battery|ac}"; then echo "end session (${2}% on $3, floor ${INSOMNIA_FLOOR:-none})"; else echo "keep session (${2}% on $3, floor ${INSOMNIA_FLOOR:-none})"; fi ;;
check-start)
  if too_low_to_start "${2:?percent}" "${3:?battery|ac}"; then echo "refuse (${2}% on $3, min ${INSOMNIA_MIN_START:-none})"; else echo "allow (${2}% on $3, min ${INSOMNIA_MIN_START:-none})"; fi ;;
_hold) hold ;;
_ended) ended ;;
*) sed -n '2,66p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
