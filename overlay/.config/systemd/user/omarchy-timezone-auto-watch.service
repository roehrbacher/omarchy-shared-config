[Unit]
Description=Watch network changes and nudge timezone mismatches
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-timezone-auto-watch
Restart=on-failure
RestartSec=10
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target
