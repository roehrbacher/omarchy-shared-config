{
  "schemaVersion": 1,
  "id": "timon.grok-usage",
  "name": "Grok",
  "version": "2.0.0",
  "author": "Timon Röhrbacher (based on grokbar-omarchy by pixbroker)",
  "license": "MIT",
  "description": "SuperGrok usage on the bar, plus optional Cursor, Grok Bot, and GPT.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Grok",
    "description": "Bar widget for SuperGrok usage, plus optional Cursor, Grok Bot, and GPT.",
    "category": "AI",
    "aliases": [
      "grok-usage",
      "grokbar-omarchy"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "showCursorUsage": false,
      "showGrokBotUsage": false,
      "showGptUsage": false,
      "authPath": "",
      "stateDbPath": "",
      "cursorAuthPath": "",
      "codexHome": "",
      "iconOnly": false,
      "usageRing": false
    },
    "schema": [
      {
        "key": "iconOnly",
        "type": "boolean",
        "label": "Icon only",
        "description": "Show only the Grok Bot logo on the bar, no usage numbers (local patch). The panel is unchanged.",
        "defaultValue": false
      },
      {
        "key": "usageRing",
        "type": "boolean",
        "label": "Usage ring",
        "description": "Icon-only mode: a ring around the Grok Bot logo shows weekly usage, in bar.active when usage runs ahead of the week (local patch).",
        "defaultValue": false
      },
      {
        "key": "showCursorUsage",
        "type": "boolean",
        "label": "Show Cursor usage",
        "description": "Show Cursor monthly pools on the bar. Off by default; also toggled from panel settings.",
        "defaultValue": false
      },
      {
        "key": "showGrokBotUsage",
        "type": "boolean",
        "label": "Show Grok Bot usage",
        "description": "Show Grok Bot weekly pool on the bar. Off by default; also toggled from panel settings.",
        "defaultValue": false
      },
      {
        "key": "showGptUsage",
        "type": "boolean",
        "label": "Show GPT usage",
        "description": "Show GPT usage from the local Codex session. Off by default; also toggled from panel settings.",
        "defaultValue": false
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "authPath",
        "type": "path",
        "label": "Grok auth.json",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.grok/auth.json."
      },
      {
        "key": "stateDbPath",
        "type": "path",
        "label": "Cursor state.vscdb",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.config/Cursor/User/globalStorage/state.vscdb."
      },
      {
        "key": "cursorAuthPath",
        "type": "path",
        "label": "Cursor CLI auth.json",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.config/cursor/auth.json."
      },
      {
        "key": "codexHome",
        "type": "path",
        "label": "Codex home directory",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.codex."
      }
    ]
  }
}
