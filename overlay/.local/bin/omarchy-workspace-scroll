#!/bin/bash
# Managed by omarchy-shared-config. Super+wheel (and the XPS 3-finger swipe):
# step through workspaces lowest occupied - 1 (min 1) .. highest occupied + 1
# (max 10), empty ones in between included. Stops at the ends (no wrap),
# like the touchpad swipe.
# Usage: omarchy-workspace-scroll next|prev
#        omarchy-workspace-scroll --plan next|prev CURRENT OCCUPIED...  (test, no dispatch)
set -u

plan() { # dir cur occupied...
  local dir=$1 cur=$2; shift 2
  local lo=10 hi=1 id
  [[ $# -eq 0 ]] && { echo "$cur"; return; }
  for id in "$@"; do ((id < lo)) && lo=$id; ((id > hi)) && hi=$id; done
  lo=$((lo - 1)); ((lo < 1)) && lo=1
  hi=$((hi + 1)); ((hi > 10)) && hi=10
  if [[ $dir == next ]]; then
    if ((cur < lo)); then echo "$lo"; elif ((cur >= hi)); then echo "$cur"; else echo $((cur + 1)); fi
  else
    if ((cur > hi)); then echo "$hi"; elif ((cur <= lo)); then echo "$cur"; else echo $((cur - 1)); fi
  fi
}

if [[ ${1:-} == --plan ]]; then shift; plan "$@"; exit 0; fi
dir=${1:-next}; [[ $dir == next || $dir == prev ]] || exit 2

cur=$(timeout 2 hyprctl -j activeworkspace | jq -r '.id') || exit 0
mapfile -t occ < <(timeout 2 hyprctl -j workspaces | jq -r '.[] | select(.id >= 1 and .id <= 10 and .windows > 0) | .id')
[[ $cur =~ ^[0-9]+$ ]] || exit 0
target=$(plan "$dir" "$cur" "${occ[@]}")
[[ $target == "$cur" ]] && exit 0
out=$(timeout 2 hyprctl dispatch "hl.dsp.focus({ workspace = \"$target\" })" 2>&1)
[[ $out == ok* ]] || timeout 2 hyprctl dispatch workspace "$target" >/dev/null
exit 0
