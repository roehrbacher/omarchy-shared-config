diff --git a/tests/pc-power-readout.test.sh b/tests/pc-power-readout.test.sh
new file mode 100755
index 0000000..c3170ea
--- /dev/null
+++ b/tests/pc-power-readout.test.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# Static check: watts stay a readable label, not an optically scaled icon slot.
+set -u
+here=$(cd "$(dirname "$0")/.." && pwd)
+qml=$here/overlay/.config/omarchy/plugins/timon.pc-power/Panel.qml
+fail=0
+need() { if grep -qF "$1" "$qml"; then echo "ok   $2"; else echo "FAIL missing: $2"; fail=1; fi; }
+forbid() { if grep -qF "$1" "$qml"; then echo "FAIL still present: $2"; fail=1; else echo "ok   $2"; fi; }
+need 'fontSize: Style.font.body' "body-size label"
+need 'Math.round(root.totalW) + "W"' "watt text kept"
+need 'CPU ' "CPU tooltip kept"
+need 'GPU ' "GPU tooltip kept"
+forbid '+ 21' "no unscaled advance+21 slot"
+forbid 'slotSize:' "BarIconButton slot no longer sizes the readout"
+forbid '00W' "no reserved two-digit hole"
+exit $fail
