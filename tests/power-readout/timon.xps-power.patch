diff --git a/tests/xps-power-readout.test.sh b/tests/xps-power-readout.test.sh
new file mode 100755
index 0000000..6920b57
--- /dev/null
+++ b/tests/xps-power-readout.test.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# Static check: battery icon stays an icon; watts and percent are a label.
+set -u
+here=$(cd "$(dirname "$0")/.." && pwd)
+qml=$here/overlay/.config/omarchy/plugins/timon.xps-power/Panel.qml
+fail=0
+need() { if grep -qF "$1" "$qml"; then echo "ok   $2"; else echo "FAIL missing: $2"; fail=1; fi; }
+forbid() { if grep -qF "$1" "$qml"; then echo "FAIL still present: $2"; fail=1; else echo "ok   $2"; fi; }
+need 'fontSize: Style.font.body' "body-size readout"
+need 'root.powerWatts + Math.round(root.batteryFraction * 100) + "%"' "watts and percent kept"
+need 'text: root.barIcon()' "icon is only the battery glyph"
+need 'root.powerWatts = "0W "' "idle 0W kept"
+need 'st === "Charging" ? "+" : "-"' "charge and discharge signs kept"
+need 'function pressPower' "click handler kept"
+need 'root.togglePercentage()' "right click still toggles percentage"
+need 'root.toggle()' "left click still opens the panel"
+need 'visible: batteryPresent' "no battery still hides the widget"
+forbid 'iconSlot *' "no 2-slot or 3-slot reservation"
+forbid 'powerWatts + Math.round(root.batteryFraction * 100) + "% " + root.barIcon()' "icon no longer concatenated into the readout"
+exit $fail
