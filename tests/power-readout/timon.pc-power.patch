+  implicitWidth: button.text !== "" ? button.implicitWidth : 0
+  implicitHeight: button.text !== "" ? button.implicitHeight : 0
 
-  BarIconButton {
+  // Omarchy 4.5 BarIconButton paints `text` through OpticalGlyph and scales
+  // the whole string into the 16 px icon canvas. "64W" stayed tiny inside a
+  // slot padded well past the ink. A label at Style.font.body is the
