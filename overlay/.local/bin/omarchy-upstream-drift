#!/usr/bin/env python3
"""omarchy-upstream-drift: did Omarchy change a plugin we copied?

For every plugin in ~/.config/omarchy/plugins that is a copy of a stock one
(manifest "omarchy.clonedFrom", or "plugin=" in an UPSTREAM-BASE file), it
compares the upstream version recorded as our base with the current one in
/usr/share/omarchy/shell/plugins and prints a plain summary.

The base is a snapshot in ~/.local/share/omarchy-upstream-base/<upstream id>/.
The first run records the current upstream as the base. After reviewing (or
merging) a change, accept it with:  omarchy-upstream-drift --accept [id ...]

  omarchy-upstream-drift            summary, exit 1 if anything changed
  omarchy-upstream-drift --diff     ...plus the full diff
  omarchy-upstream-drift --json     machine-readable
Read-only apart from the base snapshots. No network, no root."""
import difflib, glob, json, os, shutil, subprocess, sys

HOME = os.path.expanduser("~")
PLUGINS = os.path.join(HOME, ".config/omarchy/plugins")
SHELL = os.path.join(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "shell/plugins")
BASE = os.path.join(HOME, ".local/share/omarchy-upstream-base")


def omarchy_version():
    try:
        return subprocess.run(["pacman", "-Q", "omarchy"], capture_output=True, text=True).stdout.split()[1]
    except Exception:
        return "unknown"


def upstream_dirs():
    out = {}
    for m in glob.glob(os.path.join(SHELL, "**/manifest.json"), recursive=True):
        try:
            out[json.load(open(m))["id"]] = os.path.dirname(m)
        except Exception:
            pass
    return out


def copies():
    found = {}
    for d in sorted(glob.glob(os.path.join(PLUGINS, "*/"))):
        src = None
        try:
            src = json.load(open(d + "manifest.json")).get("omarchy", {}).get("clonedFrom")
        except Exception:
            pass
        if not src and os.path.exists(d + "UPSTREAM-BASE"):
            for line in open(d + "UPSTREAM-BASE"):
                if line.startswith("plugin="):
                    src = line.split("=", 1)[1].strip()
        if src:
            found.setdefault(src, []).append(os.path.basename(d.rstrip("/")))
    return found


def files(root):
    if not root or not os.path.isdir(root):
        return {}
    out = {}
    for p in glob.glob(os.path.join(root, "**/*"), recursive=True):
        if os.path.isfile(p) and not p.endswith("BASE-VERSION"):
            try:
                out[os.path.relpath(p, root)] = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                pass
    return out


def record(uid, src):
    dst = os.path.join(BASE, uid)
    shutil.rmtree(dst, ignore_errors=True)
    shutil.copytree(src, dst)
    open(os.path.join(dst, "BASE-VERSION"), "w").write(omarchy_version() + "\n")


def main(argv):
    up, cps, ver = upstream_dirs(), copies(), omarchy_version()
    if "--accept" in argv:
        ids = [a for a in argv[argv.index("--accept") + 1:] if not a.startswith("-")] or list(cps)
        for uid in ids:
            if uid in up:
                record(uid, up[uid]); print(f"{uid}: base is now Omarchy {ver}")
        return 0
    report, changed = [], False
    for uid, mine in sorted(cps.items()):
        b = os.path.join(BASE, uid)
        if uid not in up:
            report.append({"upstream": uid, "copies": mine, "status": "removed upstream"}); changed = True; continue
        if not os.path.isdir(b):
            record(uid, up[uid])
            report.append({"upstream": uid, "copies": mine, "status": f"base recorded now (Omarchy {ver})"}); continue
        bv = open(os.path.join(b, "BASE-VERSION")).read().strip() if os.path.exists(os.path.join(b, "BASE-VERSION")) else "?"
        old, new = files(b), files(up[uid])
        entries, diff = [], []
        for f in sorted(set(old) | set(new)):
            if old.get(f) == new.get(f):
                continue
            a, c = (old.get(f) or "").splitlines(), (new.get(f) or "").splitlines()
            d = list(difflib.unified_diff(a, c, f"base/{f}", f"now/{f}", lineterm=""))
            plus = sum(1 for l in d if l.startswith("+") and not l.startswith("+++"))
            minus = sum(1 for l in d if l.startswith("-") and not l.startswith("---"))
            kind = "new file" if f not in old else "deleted" if f not in new else "changed"
            entries.append(f"{f} ({kind}, +{plus} -{minus})"); diff += d
        if entries:
            changed = True
        report.append({"upstream": uid, "copies": mine, "base": bv, "now": ver,
                       "status": "changed" if entries else "unchanged", "files": entries,
                       "diff": diff if "--diff" in argv else None})
    if "--json" in argv:
        print(json.dumps(report, indent=1)); return 1 if changed else 0
    hits = [r for r in report if r["status"] not in ("unchanged",) and not r["status"].startswith("base recorded")]
    if not hits:
        print(f"Omarchy {ver}: none of the {len(report)} copied plugins changed upstream.")
    for r in report:
        if r["status"] == "unchanged" and hits:
            continue
        who = ", ".join(r["copies"])
        if r["status"] == "changed":
            print(f"{r['upstream']} (your copy: {who}) changed between Omarchy {r['base']} and {r['now']}:")
            for e in r["files"]:
                print(f"  - {e}")
            for l in r.get("diff") or []:
                print("    " + l)
        elif r["status"] != "unchanged":
            print(f"{r['upstream']} (your copy: {who}): {r['status']}")
    return 1 if changed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
