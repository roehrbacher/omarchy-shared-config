{
  // Shared menu tweaks (omarchy-shared-config). Merged into
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc by omarchy-menu-build.
  //
  // "down" used to find Shutdown (search matches inside "Shutdown"), so the
  // stock row is hidden and replaced by Power Off; shut/shutdown/power find it.
  // The label is only the title. The command is Omarchy's real subcommand
  // `omarchy-system shutdown`. There is no program named omarchy-system-shutdown;
  // renaming Shutdown to Power Off did not change which program runs.
  "system.shutdown": {"when":"false"},
  "system.poweroff": {"icon":"󰐥","label":"Power Off","aliases":["shut","poweroff","power-off","turn-off"],"description":"Shutdown the computer","action":"omarchy-system shutdown"},
  // Opens the stay-awake picker. Not `omarchy-insomnia set`, which would
  // change the inhibitor, and not the Work/omarchy-insomnia folder (menu-build
  // skips that checkout). The desktop id is omarchy-insomnia, so this does
  // not replace the Insomnia REST client.
  "insomnia": {"icon":"󰈈","label":"Insomnia","aliases":["stay-awake","stay awake","omarchy-insomnia","lid"],"description":"Open the Insomnia stay-awake popup","action":"omarchy-insomnia menu"},
  // Apps' "applications" alias made "ca" open with Apps above Calc (OmaCalc).
  "apps": {"aliases":["app"]},
  // Children are generated by omarchy-menu-build from your folders.
  "folders": {"icon":"","label":"Folders","aliases":["folder","files"]},
}
