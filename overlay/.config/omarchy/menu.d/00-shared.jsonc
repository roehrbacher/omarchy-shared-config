{
  // Shared menu tweaks (omarchy-shared-config). Merged into
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc by omarchy-menu-build.
  //
  // "down" used to find Shutdown (search matches inside "Shutdown"), so the
  // stock row is hidden and replaced by Power Off; shut/shutdown/power find it.
  "system.shutdown": {"when":"false"},
  "system.poweroff": {"icon":"󰐥","label":"Power Off","aliases":["shut","poweroff","power-off","turn-off"],"description":"Shutdown the computer","action":"omarchy-system-shutdown"},
  // Apps' "applications" alias made "ca" open with Apps above Calc (OmaCalc).
  "apps": {"aliases":["app"]},
  // Children are generated by omarchy-menu-build from your folders.
  "folders": {"icon":"","label":"Folders","aliases":["folder","files"]},
}
